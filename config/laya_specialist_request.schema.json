{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "laya-specialist-common-request-v1",
  "title": "Laya model-agnostic specialist request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "source_agent", "project", "problem_context", "proposal", "claim_under_review", "known_evidence", "requested_decision"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_agent": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "interface"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 256},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "interface": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "project": {"type": "string", "minLength": 1},
    "problem_context": {"type": "string", "minLength": 1},
    "proposal": {"type": "string", "minLength": 1},
    "claim_under_review": {"type": "string", "minLength": 1},
    "known_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_facts", "available_evidence", "missing_evidence"],
      "properties": {
        "observed_facts": {"type": "string", "minLength": 1},
        "available_evidence": {"type": "string", "minLength": 1},
        "missing_evidence": {"type": "string", "minLength": 1}
      }
    },
    "requested_decision": {"type": "string", "minLength": 1}
  }
}
